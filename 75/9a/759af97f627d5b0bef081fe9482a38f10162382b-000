CORNERS = ['TL', 'TR', 'BL', 'BR']


def ramp(points, range_):
    return hou.Ramp([hou.rampBasis.Linear] * len(points), [x / range_ for x, _ in points], [y for _, y in points])


def node(net, kind, name, inputs=(), **parms):
    n = net.node(name) or net.createNode(kind, name)
    for i, src in enumerate(inputs):
        if src is not None:
            n.setInput(i, src[0] if isinstance(src, tuple) else src, src[1] if isinstance(src, tuple) else 0)
    for k, v in parms.items():
        n.parm(k).set(v)
    return n


def const(net, name, like, value):
    return node(net, 'remap', name, [like], inputmin=0, inputmax=1, outputmin=value, outputmax=value, useramp=0)


def curve(net, name, src, keys, range_, out_min=0.0, out_max=1.0):
    # 30 September 2026 : a remap ramp must span the WHOLE input range, so the last value is held out to range_.
    keys = list(keys)
    if keys[-1][0] < range_: keys.append((range_, keys[-1][1]))
    n = node(net, 'remap', name, [src], inputmin=0, inputmax=range_, outputmin=out_min, outputmax=out_max, useramp=1)
    n.parm('ramp').set(ramp(keys, range_))
    return n


TABLE_VEX = '''// 30 September 2026 : the strength of the four quarter arcs of each tile, TL TR BL BR. Checkerboard measured on the real height
// map: three arcs at 1.0 and one low arc (an even tile A has it at BR, an odd tile B at TL). FR : damier, trois arcs pleins et un bas.
int n = %(tiles)d;
int col = clamp(int((@P.x * 0.5 + 0.5) * n), 0, n - 1);
int row = clamp(int((0.5 - @P.y * 0.5) * n), 0, n - 1);      // P.y = +1 is the TOP of the canvas, row 0 is the top row
int even = ((row + col) %% 2 == 0) ? 1 : 0;
p@C = set(even ? 1.0 : %(weak).2f, 1.0, 1.0, even ? %(weak).2f : 1.0);
'''


def build():
    net = hou.node(NET)
    for c in net.children():
        c.destroy()
    net.parm('setres').set(1); net.parm('res1').set(P['res']); net.parm('res2').set(P['res'])
    S = {}
    def reg(sec, *nodes):
        S.setdefault(sec, []).extend(n.name() for n in nodes)
    span = P['uv_span']

    # A  LAYOUT -------------------------------------------------------------------------------------------------
    lay = node(net, 'tilepattern', 'A1_layout__tile_grid_4x4', patterntype=0, patternmode=1, stackbond_rows=P['tiles'], stackbond_cols=P['tiles'])
    lay.parm('stackbond_tilewidth').set(2.0 / P['tiles']); lay.parm('stackbond_tileheight').set(2.0 / P['tiles'])
    u = node(net, 'channelextract', 'A2_layout__tile_u', [(lay, 2)], channel=0)
    v = node(net, 'channelextract', 'A3_layout__tile_v', [(lay, 2)], channel=1)
    reg('A  LAYOUT  the tile grid', lay, u, v)

    # B  KEPT ARCS ---------------------------------------------------------------------------------------------
    tbl = node(net, 'wrangle', 'B1_arcs__checkerboard_arc_strengths', [(lay, 0)])
    tbl.parm('vexsnippet').set(TABLE_VEX % {'tiles': P['tiles'], 'weak': P['weak_strength']})
    kept = {c: node(net, 'channelextract', f'B{2 + i}_arcs__strength_{c}', [tbl], channel=i) for i, c in enumerate(CORNERS)}
    rad = const(net, 'B6_arcs__radius_constant', u, P['radius'])
    reg('B  ARCS  strength of each corner arc', tbl, *kept.values(), rad)

    # C  ONE DISTANCE CHAIN PER CORNER ---------------------------------------------------------------------------
    dist, gated, corner_d = {}, {}, {}
    for i, c in enumerate(CORNERS):
        left, top = c[1] == 'L', c[0] == 'T'
        du = node(net, 'remap', f'C{i}1_{c}__offset_u_from_corner', [u], inputmin=-span, inputmax=span,
                  outputmin=0 if left else 1, outputmax=1 if left else 0, useramp=0)
        toward_top = top == P['v_up']
        dv = node(net, 'remap', f'C{i}2_{c}__offset_v_from_corner', [v], inputmin=-span, inputmax=span,
                  outputmin=1 if toward_top else 0, outputmax=0 if toward_top else 1, useramp=0)
        d = node(net, 'blend', f'C{i}3_{c}__distance_to_corner', [du, dv], mode=8)
        a = node(net, 'blend', f'C{i}4_{c}__distance_to_arc', [d, rad], mode=9)
        corner_d[c], gated[c] = d, a
        reg(f'C  CORNER {c}  distance to its arc', du, dv, d, a)

    # D  NEAREST KEPT ARC, AND WHICH SIDE OF IT WE ARE ON -----------------------------------------------------
    n1 = node(net, 'blend', 'D1_arcs__nearest_of_TL_TR', [gated['TL'], gated['TR']], mode=13)
    n2 = node(net, 'blend', 'D2_arcs__nearest_of_BL_BR', [gated['BL'], gated['BR']], mode=13)
    near = node(net, 'blend', 'D3_arcs__distance_to_nearest_arc', [n1, n2], mode=13)
    side_parts, str_parts = [], []
    for i, c in enumerate(CORNERS):
        gap = node(net, 'blend', f'C{i}7_{c}__gap_to_the_nearest_arc', [gated[c], near], mode=9)
        is_near = curve(net, f'C{i}8_{c}__is_the_nearest_arc', gap, [(0.0, 1.0), (0.00002, 0.0)], 1.0)
        inside = curve(net, f'C{i}9_{c}__inside_its_disc', corner_d[c], [(0.0, 1.0), (P['radius'] - 0.0005, 1.0), (P['radius'], 0.0)], 1.5)
        nin = node(net, 'blend', f'C{i}A_{c}__nearest_and_inside', [is_near, inside], mode=5)
        nst = node(net, 'blend', f'C{i}B_{c}__nearest_arc_strength', [is_near, kept[c]], mode=5)
        side_parts.append(nin); str_parts.append(nst)
        reg(f'C  CORNER {c}  distance to its arc', gap, is_near, inside, nin, nst)
    s1 = node(net, 'blend', 'D4_side__TL_plus_TR', [side_parts[0], side_parts[1]], mode=3)
    s2 = node(net, 'blend', 'D5_side__BL_plus_BR', [side_parts[2], side_parts[3]], mode=3)
    side = node(net, 'blend', 'D6_side__inside_the_nearest_disc', [s1, s2], mode=3)
    t1 = node(net, 'blend', 'D7_strength__TL_plus_TR', [str_parts[0], str_parts[1]], mode=3)
    t2 = node(net, 'blend', 'D8_strength__BL_plus_BR', [str_parts[2], str_parts[3]], mode=3)
    strength = node(net, 'blend', 'D9_strength__of_the_nearest_arc', [t1, t2], mode=3)
    reg('D  NEAREST ARC  its side and its strength', n1, n2, near, s1, s2, side, t1, t2, strength)

    # E  RELIEF: TWO MEASURED PROFILES, CHOSEN BY THE SIDE --------------------------------------------------------
    p_in = curve(net, 'E1_relief__profile_inside_disc', near, P['inside_keys'], 1.0)
    p_out = curve(net, 'E2_relief__profile_outside_star', near, P['outside_keys'], 1.0)
    p_flat = curve(net, 'E3_relief__profile_without_any_ridge', near, P['flat_keys'], 1.0)
    ridge = node(net, 'blend', 'E4_relief__ridge_inside_or_outside', [p_out, p_in, side], mode=0)
    relief = node(net, 'blend', 'E5_relief__ridge_scaled_by_arc_strength', [p_flat, ridge, strength], mode=0)
    reg('E  RELIEF  measured profile of the real height map', p_in, p_out, p_flat, ridge, relief)

    # F  JOINTS -----------------------------------------------------------------------------------------------
    eu = curve(net, 'F1_joints__edge_distance_from_u', u, [(0.0, 0.0), (0.5, 0.5), (1.0, 0.0)], 1.0)
    eu.parm('inputmin').set(-span); eu.parm('inputmax').set(span)
    ev = curve(net, 'F2_joints__edge_distance_from_v', v, [(0.0, 0.0), (0.5, 0.5), (1.0, 0.0)], 1.0)
    ev.parm('inputmin').set(-span); ev.parm('inputmax').set(span)
    edge = node(net, 'blend', 'F3_joints__distance_to_tile_edge', [eu, ev], mode=13)
    groove = curve(net, 'F4_joints__groove_multiplier', edge, P['groove_keys'], P['groove_range'])
    grooved = node(net, 'blend', 'F5_joints__apply_groove', [relief, groove], mode=5)
    reg('F  JOINTS  the thin grooves between tiles', eu, ev, edge, groove, grooved)

    # G  EACH TILE IS A LITTLE DIFFERENT -----------------------------------------------------------------------
    rnd = node(net, 'randommono', 'G1_tiles__random_per_tile', [(lay, 1), None, None, None, (lay, 1)])
    lvl = node(net, 'remap', 'G2_tiles__level_offset', [rnd], inputmin=0, inputmax=1, outputmin=-P['tile_level_jitter'], outputmax=P['tile_level_jitter'], useramp=0)
    varied = node(net, 'blend', 'G3_tiles__apply_level_offset', [grooved, lvl], mode=3)
    reg('G  TILES  each tile a little different', rnd, lvl, varied)

    # H  HAND-MADE SURFACE -------------------------------------------------------------------------------------
    wave = node(net, 'fractalnoise', 'H1_surface__slow_waviness', elementsize=P['wave_size'], amp=P['wave_amp'], center=0, offx=3.0)
    grain = node(net, 'fractalnoise', 'H2_surface__fine_grain', elementsize=P['grain_size'], amp=P['grain_amp'], center=0, offx=9.0)
    surf = node(net, 'blend', 'H3_surface__waviness_plus_grain', [wave, grain], mode=3)
    surfaced = node(net, 'blend', 'H4_surface__apply_to_relief', [varied, surf], mode=3)
    reg('H  SURFACE  hand-made unevenness', wave, grain, surf, surfaced)

    # I  OUTPUT -------------------------------------------------------------------------------------------------
    out = node(net, 'null', 'I1_HEIGHT__ceramic_green_v3', [surfaced])
    nrm = node(net, 'heighttonormal', 'I2_preview__normal_from_height', [out])
    rop = node(net, 'rop_image', 'I3_export__height_png', [out])
    rop.parm('copoutput').set(OUT_DIR + '/render/CeramicGreen_V3_height.png'); rop.parm('colorconversion').set('raw')
    out.setDisplayFlag(True)
    reg('I  OUTPUT', out, nrm, rop)
    return net, S


COLORS = {'A': (0.45, 0.45, 0.50), 'B': (0.55, 0.45, 0.75), 'C': (0.35, 0.52, 0.72), 'D': (0.28, 0.40, 0.58),

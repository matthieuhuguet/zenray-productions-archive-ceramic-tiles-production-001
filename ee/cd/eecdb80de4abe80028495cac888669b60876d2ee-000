# 1 October 2026 : prepares the editor world for a TRANSPARENT-BACKGROUND render of ONE sphere of the commercial level (Matthieu: "une image sur fond noir transparent depuis Unreal de la sphere verte"). Runs in the ZenRayShards editor through Scripts/UeQueue.py. Job file: unreal/sphere_pass_job.json {"mode": "beauty" | "mask" | "restore", "keep": "AdSpheres40Green", "gain": 1.0}.
# beauty : every mesh actor of the commercial except <keep> is hidden in game (cyclorama, planes, other spheres): the sphere stays lit by the real light rig and renders on a black background (premultiplied by construction). mask : same, plus the sphere takes the unlit white material MI_CeramicAdMask (emissive = gain) so the render is its exact silhouette (anti aliased by the same spatial x temporal samples). restore : unhides everything and gives the sphere its own material back (state in unreal/sphere_pass_state.json). The level is NEVER saved. FR : prepare le monde editeur pour un rendu d'une seule sphere sur fond noir.
import unreal, json, os
PROJ = '/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-materials-substance-copernicus-30-09-2026/unreal/'
J = json.load(open(PROJ + 'sphere_pass_job.json')); P = json.load(open(PROJ + 'ue_params.json'))
les = unreal.get_editor_subsystem(unreal.LevelEditorSubsystem); eas = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
if unreal.EditorLevelLibrary.get_editor_world().get_name() != P['level'].rsplit('/', 1)[1]: les.load_level(P['level'])
assert unreal.EditorLevelLibrary.get_editor_world().get_name() == P['level'].rsplit('/', 1)[1], 'wrong level open'
STATE = PROJ + 'sphere_pass_state.json'
MAT_DIR = '/Game/ZenRayShards/Materials/CeramicAd'; MASK_M, MASK_MI = MAT_DIR + '/M_CeramicAdMask', MAT_DIR + '/MI_CeramicAdMask'
meshes = [a for a in eas.get_all_level_actors() if isinstance(a, unreal.StaticMeshActor) and a.get_actor_label().startswith('Ad') and a.get_actor_label() != 'AdFocusShot3']
keep = [a for a in meshes if a.get_actor_label() == J.get('keep')]
mode = J['mode']
if mode in ('beauty', 'mask'):
    assert len(keep) == 1, 'sphere actor not found: %s' % J.get('keep')
    sph = keep[0]; st = json.load(open(STATE)) if os.path.exists(STATE) else {}
    if J['keep'] not in st: st[J['keep']] = sph.static_mesh_component.get_material(0).get_path_name().split('.')[0]; json.dump(st, open(STATE, 'w'))
    for a in meshes:
        if a is not sph: a.set_actor_hidden_in_game(True)
    sph.set_actor_hidden_in_game(False)
    if mode == 'mask':
        mel, tools = unreal.MaterialEditingLibrary, unreal.AssetToolsHelpers.get_asset_tools()
        if not unreal.EditorAssetLibrary.does_asset_exist(MASK_M):
            m = tools.create_asset('M_CeramicAdMask', MAT_DIR, unreal.Material, unreal.MaterialFactoryNew())
            m.set_editor_property('shading_model', unreal.MaterialShadingModel.MSM_UNLIT)
            g = mel.create_material_expression(m, unreal.MaterialExpressionScalarParameter, -500, 0); g.set_editor_property('parameter_name', 'MaskGain'); g.set_editor_property('default_value', 1.0)
            mel.connect_material_property(g, '', unreal.MaterialProperty.MP_EMISSIVE_COLOR)
            mel.recompile_material(m); unreal.EditorAssetLibrary.save_asset(MASK_M)
        if not unreal.EditorAssetLibrary.does_asset_exist(MASK_MI):
            mi = tools.create_asset('MI_CeramicAdMask', MAT_DIR, unreal.MaterialInstanceConstant, unreal.MaterialInstanceConstantFactoryNew())
            mi.set_editor_property('parent', unreal.EditorAssetLibrary.load_asset(MASK_M))
        mi = unreal.EditorAssetLibrary.load_asset(MASK_MI); mel.set_material_instance_scalar_parameter_value(mi, 'MaskGain', float(J.get('gain', 1.0))); unreal.EditorAssetLibrary.save_asset(MASK_MI)
        sph.static_mesh_component.set_material(0, mi)
    else:
        sph.static_mesh_component.set_material(0, unreal.EditorAssetLibrary.load_asset(json.load(open(STATE))[J['keep']]))
    print('OK pass', mode, 'keep', J['keep'], 'hidden', len(meshes) - 1, 'gain', J.get('gain'))
elif mode == 'restore':
    st = json.load(open(STATE)) if os.path.exists(STATE) else {}
    for a in meshes: a.set_actor_hidden_in_game(False)
    for lab, path in st.items():
        for a in meshes:
            if a.get_actor_label() == lab: a.static_mesh_component.set_material(0, unreal.EditorAssetLibrary.load_asset(path))
    print('OK restored', len(meshes), 'actors visible, materials', list(st))

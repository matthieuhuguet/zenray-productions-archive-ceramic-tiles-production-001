# 30 September 2026 : find the exact tile geometry of ref_basecolor.png (tile size T in reference pixels, joint offsets ox, oy, arc radius R, which corner is faint) by
# maximising the correlation between the tan-line mask of the reference and a numpy model of the arcs and joints. FR : geometrie exacte de la ref (taille, decalage, rayon).
import numpy as np, json, itertools
from PIL import Image
from scipy import ndimage as ndi
ref = np.asarray(Image.open('ref-maps/ref_basecolor.png').convert('RGB')).astype(np.float32) / 255
H, W = ref.shape[:2]
line = np.clip((ref[..., 0] - ref[..., 2]) - 0.16, 0, 1)
line = ndi.gaussian_filter(line, 1.0)
# 1) joints: peaks of the mean line profile
col = line.mean(0); row = line.mean(1)
def peaks(v, min_dist=200):
    idx = [i for i in range(2, len(v) - 2) if v[i] == v[max(0, i - 40):i + 41].max() and v[i] > v[i - 1:i + 2].mean() * 0.99 and v[i] > 1.3 * v.mean()]
    out = []
    for i in idx:
        if not out or i - out[-1] > min_dist: out.append(i)
    return out
px, py = peaks(col), peaks(row)
print('vertical joints x', px, ' horizontal joints y', py)
T = 408.25                         # 30 September 2026 : measured earlier on the sheet; the automatic peaks also caught arcs
ox = px[0] % T if px else 0.0; oy = 3.0
print('T', round(T, 2), 'ox', round(ox, 2), 'oy', round(oy, 2))
yy, xx = np.mgrid[0:H, 0:W].astype(np.float32)
def model(R, parity, T, ox, oy, width=0.008):
    tx = (xx - ox) / T; ty = (yy - oy) / T
    col_i = np.floor(tx).astype(int); row_i = np.floor(ty).astype(int)
    u = tx - col_i; v = ty - row_i
    dd = np.full(u.shape, 9.0, np.float32)
    skip = np.where((row_i + col_i) % 2 == parity, 0, 1)
    for cu in (0, 1):
        for cv in (0, 1):
            d = np.abs(np.hypot(u - cu, v - cv) - R)
            d = np.where((skip == cu) & (cu == cv), 9.0, d)
            dd = np.minimum(dd, d)
    e = np.minimum(np.minimum(u, 1 - u), np.minimum(v, 1 - v))
    return 1 - np.clip(np.minimum(dd, e) / width, 0, 1), dd, e
best = (-2,)
for parity in (0, 1):
    for R in np.arange(0.480, 0.520, 0.0025):
        for dT in (-4, -2, 0, 2, 4):
            for dox in range(-3, 4):
                for doy in range(-3, 4):
                    m, _, _ = model(R, parity, T + dT * 0.25, ox + dox, oy + doy)
                    c = np.corrcoef(m.ravel(), line.ravel())[0, 1]
                    if c > best[0]: best = (c, parity, R, T + dT * 0.25, ox + dox, oy + doy)
print('best corr, parity, R, T, ox, oy =', best)
json.dump({'corr': float(best[0]), 'parity': int(best[1]), 'R': float(best[2]), 'T': float(best[3]), 'ox': float(best[4]), 'oy': float(best[5])}, open('ref-maps/basecolor_geometry.json', 'w'))

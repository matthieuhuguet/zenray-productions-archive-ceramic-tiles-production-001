x = lin(np.asarray(Image.open(U % 481).convert('RGB').resize((256, 256), Image.BOX), dtype=np.float32)); yy, xx = np.mgrid[0:256, 0:256]; m = ((yy - 128) ** 2 + (xx - 128) ** 2) < (0.3 * 256) ** 2; v = x[m].mean(axis=0)
hx = lin(np.asarray(Image.open(P + 'render/ad_preview/hou4096maps/ad_0481.png').convert('RGB').resize((256, 256), Image.BOX), dtype=np.float32)); w = hx[m].mean(axis=0)
print('4. hue of the green sphere (frame 481): R/G Unreal %.3f Houdini %.3f | B/G Unreal %.3f Houdini %.3f' % (v[0] / v[1], w[0] / w[1], v[2] / v[1], w[2] / w[1]))
def d(f1, f2): a, b = gray(U % f1, 128), gray(U % f2, 128); return float(np.sqrt(((a - b) ** 2).mean()) / a.mean())

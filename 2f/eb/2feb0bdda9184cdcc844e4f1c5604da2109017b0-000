import numpy as np, os
from PIL import Image, ImageFilter
P = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles/'; U = P + 'render/final_ue/ad_%04d.png'; H = P + 'render/ad_preview/s003/ad_%04d.png'
def lin(a): a = a / 255.0; return np.where(a <= 0.04045, a / 12.92, ((a + 0.055) / 1.055) ** 2.4)
def gray(path, size=512): return lin(np.asarray(Image.open(path).convert('RGB').resize((size, size), Image.BOX), dtype=np.float32)).mean(axis=2)
def edges(path, size=384, angle=0.0):
    im = Image.open(path).convert('L').resize((size, size), Image.LANCZOS).filter(ImageFilter.GaussianBlur(1.2))
    if angle: im = im.rotate(angle, resample=Image.BICUBIC)
    a = np.asarray(im, dtype=np.float32) / 255; gx = np.abs(np.diff(a, axis=1))[:-1, :]; gy = np.abs(np.diff(a, axis=0))[:, :-1]; e = np.sqrt(gx ** 2 + gy ** 2)
    h = e.shape[0]; yy, xx = np.mgrid[0:h, 0:h]; return e * (((yy - h / 2) ** 2 + (xx - h / 2) ** 2) < (0.34 * h) ** 2)
def corr(a, b): a = a - a.mean(); b = b - b.mean(); return float((a * b).sum() / np.sqrt((a * a).sum() * (b * b).sum() + 1e-12))
def rot_between(p0, p1):
    e0 = edges(p0); best = max(((corr(e0, edges(p1, angle=a)), a) for a in np.arange(-100, 100.1, 1.0)), key=lambda x: x[0]); return best[1], best[0]
print('1. rotation of the turning spheres (shot 5, frames 481 -> 520, expected magnitude 78 degrees): Houdini %.0f (corr %.2f) | Unreal %.0f (corr %.2f)' % (*rot_between(H % 481, H % 520), *rot_between(U % 481, U % 520)))
def shift_x(p0, p1):
    a, b = gray(p0, 256), gray(p1, 256); a = a - a.mean(); b = b - b.mean(); f = np.fft.ifft2(np.fft.fft2(a) * np.conj(np.fft.fft2(b))).real; y, x = np.unravel_index(np.argmax(f), f.shape); x = x - 256 if x > 128 else x; y = y - 256 if y > 128 else y; return x, y
print('2. roll of the green sphere (shot 4 hold, frames 361 -> 373), horizontal shift of the pattern in px at 256 (positive = towards +X, expected for a roll towards the slide direction): Unreal', shift_x(U % 373, U % 361))

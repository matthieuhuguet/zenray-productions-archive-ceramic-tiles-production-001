# 2 October 2026 : rewrites every string parameter (and spare parameter default) that holds the OLD project root, in a hip, to the project root. Usage: hython Scripts/RepointHip.py <hip in> <hip out> [old root] [new root]. FR : réécrit les chemins d'une scène après un déplacement de projet.
import hou, sys
OLD = sys.argv[3] if len(sys.argv) > 3 else '/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-materials-substance-copernicus-30-09-2026'
NEW = sys.argv[4] if len(sys.argv) > 4 else '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles'
hou.hipFile.load(sys.argv[1], suppress_save_prompt=True, ignore_load_warnings=True)
n = 0
for nd in hou.node('/').allSubChildren():
    for p in nd.parms():
        try: v = p.unexpandedString()
        except Exception: continue
        if isinstance(v, str) and OLD in v:
            try: p.set(v.replace(OLD, NEW)); n += 1
            except Exception as e: print('skip', nd.path(), p.name(), e)
print('parameters repointed', n)
hou.hipFile.save(sys.argv[2])

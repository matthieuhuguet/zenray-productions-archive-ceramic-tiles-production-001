# 30 September 2026 : measure ref_basecolor.png against MY exact fields (true arc distance dd, tile-edge distance e), float precision. 1) find the window (x0, and y0 by rows) by
# correlating the line mask 2) bin the reference colour against dd and e at 1/1920 tile steps 3) print the glaze statistics. Output: ref-maps/basecolor_profiles.json.
# FR : mesure ref_basecolor en fonction de mes champs exacts (distance a l'arc, distance au bord) ; sortie JSON reprise par le graphe.
import json, numpy as np
from PIL import Image
D = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles'
ref = np.asarray(Image.open(f'{D}/ref-maps/ref_basecolor.png').convert('RGB')).astype(np.float32) / 255
H, W = ref.shape[:2]; sc = 408.25 / 480; ww = int(round(W / sc)); hh = int(round(H / sc))
dd_full = np.asarray(Image.open(f'{D}/render/float/dd.tif')).astype(np.float32)
ed_full = np.asarray(Image.open(f'{D}/render/float/edge.tif')).astype(np.float32)
# reference line mask: saturation of orange/tan (r - b large and r > g) is high on lines and low on the green glaze
line = np.clip((ref[..., 0] - ref[..., 2]) - 0.18, 0, 1)
best = (-2, 0, 0)
for y0 in range(0, 1920 - hh + 1, 4):
    for x0 in range(0, 1920 - ww + 1, 4):
        pass
    break
def crop(a, x0, y0): return np.asarray(Image.fromarray(a[y0:y0 + hh, x0:x0 + ww]).resize((W, H), Image.BILINEAR))
for y0 in (0, 480, 960, 1440 - 0):
    if y0 + hh > 1920: continue
    for x0 in range(0, 1920 - ww + 1, 2):
        m = 1 - np.clip(crop(dd_full, x0, y0) / 0.02, 0, 1)
        c = np.corrcoef(m.ravel(), line.ravel())[0, 1]
        if c > best[0]: best = (c, x0, y0)
c, x0, y0 = best; print('window x0', x0, 'y0', y0, 'corr', round(float(c), 3))
dd = crop(dd_full, x0, y0); ed = crop(ed_full, x0, y0)
def prof(field, edges, mask=None):
    out = []
    for lo, hi in zip(edges[:-1], edges[1:]):
        s = (field >= lo) & (field < hi)
        if mask is not None: s &= mask
        out.append([float(lo), float(hi), int(s.sum())] + ([float(v) for v in ref[s].mean(0)] if s.sum() > 30 else [None] * 3))
    return out
pxt = 1 / 408.25                                   # one reference pixel in tile units
edges_dd = [0, 0.5 * pxt, pxt, 1.5 * pxt, 2 * pxt, 3 * pxt, 4 * pxt, 5 * pxt, 6 * pxt, 8 * pxt, 10 * pxt, 13 * pxt, 16 * pxt, 20 * pxt, 25 * pxt, 32 * pxt, 45 * pxt, 70 * pxt, 0.5]
edges_e = [0, 0.5 * pxt, pxt, 1.5 * pxt, 2 * pxt, 3 * pxt, 4 * pxt, 6 * pxt, 8 * pxt, 12 * pxt, 16 * pxt, 24 * pxt, 40 * pxt, 0.5]
away_e = ed > 24 * pxt; away_d = dd > 70 * pxt
res = {'window': [x0, y0], 'dd_profile': prof(dd, edges_dd, ed > 10 * pxt), 'edge_profile': prof(ed, edges_e, dd > 10 * pxt)}
glaze = away_e & away_d
g = ref[glaze]
res['glaze_mean'] = [float(v) for v in g.mean(0)]; res['glaze_std'] = [float(v) for v in g.std(0)]
res['glaze_pct'] = {str(p): [float(v) for v in np.percentile(g, p, axis=0)] for p in (1, 5, 25, 50, 75, 95, 99)}
from scipy import ndimage as ndi
lum = ref.mean(2)
for name, sg in (('broad', 30), ('medium', 8), ('fine', 1.5)):
    hp = ndi.gaussian_filter(lum, sg)
    res['std_lowpass_' + name] = float(hp[glaze].std())
res['std_grain'] = float((lum - ndi.gaussian_filter(lum, 1.5))[glaze].std())
res['speck_fraction_above_+0.12'] = float(((lum - ndi.gaussian_filter(lum, 3)) > 0.12)[glaze].mean())
json.dump(res, open(f'{D}/ref-maps/basecolor_profiles.json', 'w'), indent=1)
print('glaze mean', np.round(res['glaze_mean'], 3), 'std', np.round(res['glaze_std'], 3))
print('lowpass std broad/medium/fine', round(res['std_lowpass_broad'], 4), round(res['std_lowpass_medium'], 4), round(res['std_lowpass_fine'], 4), 'grain', round(res['std_grain'], 4), 'specks', round(res['speck_fraction_above_+0.12'], 5))
print('dd profile (px, r g b):')
for a, b, n, r, gg, bb in res['dd_profile']: print(round(a / pxt, 1), round(b / pxt, 1), n, None if r is None else (round(r, 3), round(gg, 3), round(bb, 3)))
print('edge profile:')
for a, b, n, r, gg, bb in res['edge_profile']: print(round(a / pxt, 1), round(b / pxt, 1), n, None if r is None else (round(r, 3), round(gg, 3), round(bb, 3)))

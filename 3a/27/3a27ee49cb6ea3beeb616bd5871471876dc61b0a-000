# 30 September 2026 : quick lit preview of the five maps (basecolor, normal DirectX, roughness, ao) to judge the material against the final render
# without leaving Python: Lambert key light + ambient * AO + Blinn-Phong highlights with a softbox and a dark environment. FR : apercu eclaire.
# Usage: python3 PreviewLitFromMaps.py [prefix]  -> render/<prefix>_lit.png and a side-by-side with 01a
import sys, numpy as np
from PIL import Image
D = '/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-materials-substance-copernicus-30-09-2026'
pre = sys.argv[1] if len(sys.argv) > 1 else 'CeramicGreen_V5'
ld = lambda n: np.asarray(Image.open(f'{D}/render/{pre}_{n}.png').convert('RGB')).astype(np.float32) / 255
alb = ld('basecolor') ** 2.2; nm = ld('normal'); rough = ld('roughness')[..., :1]; ao = ld('ao')[..., :1]
n = np.stack([nm[..., 0] * 2 - 1, -(nm[..., 1] * 2 - 1), nm[..., 2] * 2 - 1], -1); n /= np.linalg.norm(n, axis=-1, keepdims=True) + 1e-6
L = np.array([-0.45, 0.55, 0.70]); L /= np.linalg.norm(L)
V = np.array([0, 0, 1.0]); Hh = (L + V); Hh /= np.linalg.norm(Hh)
ndl = np.clip((n * L).sum(-1, keepdims=True), 0, 1)
diff = alb * (0.16 * ao + 1.25 * ndl * ao)
sh = 2.0 / np.clip(rough, 0.03, 1) ** 2
spec = 0.05 + 0.9 * np.clip((n * Hh).sum(-1, keepdims=True), 0, 1) ** np.clip(sh, 8, 900) * (1 - rough)
sky = np.clip(0.5 + 0.5 * n[..., 1:2] * 2 - 0.2 * n[..., 0:1], 0, 1) ** 6                 # softbox reflection towards the top
out = diff + spec * 0.9 * (ndl > 0) + 0.35 * sky * (1 - rough)
out = np.clip(out, 0, 1) ** (1 / 2.2)
im = Image.fromarray((out * 255).astype(np.uint8)); im.save(f'{D}/render/{pre}_lit.png')
ref = Image.open(f'{D}/01a-julien-delannoy-10-left.png').convert('RGB').resize((960, 960))
side = Image.new('RGB', (1930, 960), (30, 30, 30)); side.paste(ref, (0, 0)); side.paste(im.resize((960, 960)), (970, 0)); side.save(f'{D}/render/{pre}_lit_vs_final.png')

def edit_to_source(n):
    """film frame n (1..EDIT_FRAMES) -> frame of the 720-frame Unreal pool"""
    assert 1 <= n <= EDIT_FRAMES, n
    i, j = divmod(n - 1, SHOT_FRAMES); return EDIT_ORDER[i] * SHOT_FRAMES + j + 1
def source_to_edit(f):
    """frame f of the pool -> film frame, or None when the shot is not in the film"""
    k, j = divmod(f - 1, SHOT_FRAMES)
    return EDIT_ORDER.index(k) * SHOT_FRAMES + j + 1 if k in EDIT_ORDER else None

# 30 September 2026 : same real height map as FitHeightFromRef.py, but the four corner halos are combined by MAXIMUM instead of sum:
#   h = base(edge distance) + max over the 4 corners of f_kind(|d_c - R|), f_strong for the three full arcs, f_weak for the faint one.
# Reason (30 September 2026): where two arcs cross on a tile edge the real map stays near the height of ONE arc (about 0.6), the additive fit saturated at 1.0.
# Non linear least squares on the knot values (scipy). Output: ref-maps/fit_height_max.json.
# FR : ajustement avec combinaison par MAXIMUM des halos (les croisements ne s'additionnent pas dans la vraie height).
import numpy as np, json, sys
from PIL import Image
from scipy.optimize import least_squares
D = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles/ref-maps'
h = np.asarray(Image.open(D + '/ref_height.png').convert('L')).astype(np.float64) / 255
H, W = h.shape; T = 408.25; X0 = 325.0 - T; R = 0.4975
K = np.array([0, .004, .009, .015, .022, .03, .04, .052, .066, .082, .1, .125, .155, .19, .23, .28, .34, .42, .52, 0.75, 1.5])
E = np.array([0, .0025, .005, .0075, .012, .02, .04])              # joint groove only (distance to the tile edge, tile units)
RC = np.array([0, .1, .2, .3, .4, .5, .6, .72])                    # smooth radial base from the tile CENTRE: round contours, no square creases (30 September 2026)
Y, X = np.mgrid[0:H, 0:W]; A_list = []; weakflag = []; edge = []; rad = []; yv = []
for row in range(4):
    y0 = row * T; sel = (X >= 3) & (X <= W - 3) & (Y >= y0 + 1) & (Y <= y0 + T - 1) & (X % 3 == 0) & (Y % 3 == 0)
    x = X[sel].astype(float); y = Y[sel].astype(float); u = (x - X0) / T; v = (y - y0) / T
    weak = 'TL' if row % 2 == 0 else 'BR'
    ds = []; wf = []
    for c, (cu, cv) in {'TL': (0, 0), 'TR': (1, 0), 'BL': (0, 1), 'BR': (1, 1)}.items():
        ds.append(np.abs(np.hypot(u - cu, v - cv) - R)); wf.append(np.full(x.size, c == weak))
    A_list.append(np.stack(ds)); weakflag.append(np.stack(wf)); edge.append(np.minimum.reduce([u, 1 - u, v, 1 - v])); rad.append(np.hypot(u - .5, v - .5)); yv.append(h[sel])
Ad = np.concatenate(A_list, axis=1); Wf = np.concatenate(weakflag, axis=1); Ed = np.concatenate(edge); Rd = np.concatenate(rad); b = np.concatenate(yv)
nE, nK, nR = E.size, K.size, RC.size
def model(p):
    ev, fs, fw, rv = p[:nE], p[nE:nE + nK], p[nE + nK:nE + 2 * nK], p[nE + 2 * nK:]
    gs = np.interp(Ad, K, fs); gw = np.interp(Ad, K, fw); g = np.where(Wf, gw, gs).max(axis=0)
    return np.interp(Ed, E, ev) + np.interp(Rd, RC, rv) + g
p0 = np.concatenate([np.zeros(nE), np.interp(K, [0, .1, .3, 1.5], [.5, .2, .05, .02]), np.interp(K, [0, .2, .4, 1.5], [.1, .1, .02, .0]), np.zeros(nR)])
# 30 September 2026 : smoothness penalty (second differences of every curve) so the curves have no steps; steps showed up as
# rectangular and circular blocks in the normal map derived from the height. lam is read from the command line.
# FR : penalite de lissage (differences secondes) : sans elle la normale montrait des marches en blocs et en cercles.
LAM = float(sys.argv[1]) if len(sys.argv) > 1 else 0.05
SQN = np.sqrt(b.size)
def resid(p):
    ev, fs, fw, rv = p[:nE], p[nE:nE + nK], p[nE + nK:nE + 2 * nK], p[nE + 2 * nK:]
    pen = np.concatenate([np.diff(x, 2) for x in (ev[1:], fs, fw, rv)]) * LAM * SQN
    return np.concatenate([model(p) - b, pen])
r = least_squares(resid, p0, method='trf', max_nfev=60, x_scale=0.1)
pred = model(r.x); res = b - pred
print('lam', LAM, 'largest jump between two neighbouring knots: strong %.3f weak %.3f' % (np.abs(np.diff(r.x[nE:nE+nK])).max(), np.abs(np.diff(r.x[nE+nK:nE+2*nK])).max()))
print('samples', b.size, 'RMS %.4f  corr %.4f' % (res.std(), np.corrcoef(pred, b)[0, 1]), ' (additive model was RMS 0.0450 corr 0.9295)')
out = {'edge_knots': E.tolist(), 'edge_values': r.x[:nE].tolist(), 'radial_knots': RC.tolist(), 'radial_values': r.x[nE + 2 * nK:].tolist(), 'halo_knots': K.tolist(), 'strong': r.x[nE:nE + nK].tolist(), 'weak': r.x[nE + nK:nE + 2 * nK].tolist(), 'radius': R, 'rms': float(res.std()), 'combine': 'maximum'}
json.dump(out, open(D + '/fit_height_max2.json', 'w'))
print('edge  :', ' '.join('%.3f:%.3f' % (e, v) for e, v in zip(E, out['edge_values'])))
print('strong:', ' '.join('%.3f:%.3f' % (k, v) for k, v in zip(K, out['strong'])))
print('weak  :', ' '.join('%.3f:%.3f' % (k, v) for k, v in zip(K, out['weak'])))

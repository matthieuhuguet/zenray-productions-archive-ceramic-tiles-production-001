# 30 September 2026 : the glaze hue is baked into the basecolor map, so a change must re-export that map. The callback is DEBOUNCED: it arms one event loop tick that exports 0.8 s after the LAST change
# (a slider drag fires the callback many times; one export takes about 9 s and would freeze the UI if it ran at every tick). FR : le hue est cuit dans la carte, l'export se fait 0,8 s apres le dernier changement.
HUE_CALLBACK = """import sys, time, hou
m = sys.modules.get('zr_hue_debounce')
if m is None:
    import types
    m = types.ModuleType('zr_hue_debounce'); sys.modules['zr_hue_debounce'] = m; m.t = 0.0; m.armed = False
    def tick():
        if time.time() - m.t > 0.8:
            hou.ui.removeEventLoopCallback(tick); m.armed = False
            n = hou.node('/obj/CeramicGreen_Height'); n.node('U4_export__basecolor_v6').parm('execute').pressButton()
            sh = hou.node('/mat/CeramicGreen_Material')
            if sh is not None: sh.parm('basecolor_useTexture').set(0); sh.parm('basecolor_useTexture').set(1)      # re-import the texture in Solaris / Karma
    m.tick = tick
m.t = time.time()
if not m.armed:
    m.armed = True; hou.ui.addEventLoopCallback(m.tick)
"""
CALLBACKS = {'glaze_hue': HUE_CALLBACK}
def CH(name): return 'chf("%s/%s")' % (NETPATH, name)
def make_controls(net):
    import hou
    old = {p.name(): p.eval() for p in net.parms()}
    ptg = net.parmTemplateGroup()
    for cat in ('PATTERN', 'COLOUR', 'RENDER'):
        folder = ptg.findFolder(['HDA ' + cat.title()])
        if folder is not None: ptg.remove(folder)                         # rebuilt below from SPEC, tweaked values are restored afterwards
    for cat in ('PATTERN', 'COLOUR', 'RENDER'):
        rows = [(n, l, d, lo, hi, w) for n, l, d, lo, hi, c, w in SPEC if c == cat]
        assert len(rows) <= 8, cat + ' has more than 8 parameters'       # the HDA rule: 8 per category at most
        f = hou.FolderParmTemplate('hda_' + cat.lower(), 'HDA ' + cat.title(), folder_type=hou.folderType.Simple)
        for n, l, d, lo, hi, w in rows:
            pt = hou.FloatParmTemplate(n, l, 1, default_value=(d,), min=lo, max=hi, help=w)
            if n in CALLBACKS: pt.setScriptCallback(CALLBACKS[n]); pt.setScriptCallbackLanguage(hou.scriptLanguage.Python)
            f.addParmTemplate(pt)
        ptg.append(f)
    net.setParmTemplateGroup(ptg)
    for n, *_ in SPEC:
        if n in old and net.parm(n) is not None: net.parm(n).set(old[n])
    return [n for n, *_ in SPEC]

# 30 September 2026 : one Houdini cycle run inside the live session (runpy.run_path), driven by Scripts/cycle.json so that each iteration is one short call:
#   {"rebuild": true|false, "export": ["height","basecolor","roughness","ao","normal","reflect"], "set": {"hda_param": value, "node/parm": value}, "frame": "render/frames/....png", "spp": 64}
# rebuild runs BuildCeramicGreenReflectMapV10.py (which chains V5 to V10, keeping the tweaked HDA values), the HDA values named in "set" are applied after it, then the maps are exported, the hip saved, the frame rendered.
# The MCP bridge times out during the render; the frame still arrives: wait for it with Scripts/WaitAndMeasure.sh. FR : un cycle Houdini pilote par cycle.json.
import hou, json, runpy, pathlib
B = '/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-materials-substance-copernicus-30-09-2026/'
C = json.load(open(B + 'Scripts/cycle.json'))
net = hou.node('/obj/CeramicGreen_Height'); st = hou.node('/stage')
if C.get('rebuild'):
    keep = {p.name(): p.eval() for p in net.parms() if p.name() in ('key_exposure', 'dome_exposure', 'fill_exposure', 'relief_depth', 'dish_depth', 'wall_height', 'glaze_tint', 'arc_width', 'line_width', 'layout_source', 'reflection_gain', 'reflection_blur', 'glaze_hue', 'spec_exposure', 'movement_amount', 'cloud_gain', 'mottle_gain')}
    runpy.run_path(B + 'Scripts/BuildCeramicGreenRidgeV13.py')
    net.node('W5_movement__blurred_into_a_smooth_height').parm('size').set(0.02)
    net.node('U1_normal__from_detailed_height').parm('scale').set(0.045)
    runpy.run_path(B + 'Scripts/BuildCeramicGreenPlane.py')
    for k, v in keep.items(): net.parm(k).set(v)
for k, v in C.get('set', {}).items():
    (hou.node('/obj/CeramicGreen_Height/' + k.split('/')[0]).parm(k.split('/')[1]) if '/' in k else net.parm(k)).set(v)
for k, v in C.get('stage_set', {}).items(): st.node(k.split('/')[0]).parm(k.split('/')[1]).set(v)      # e.g. "cg_key/xn__inputsangle_zta": 2.0
import time as _t
for s in C.get('export', []):
    _ex = net.node(f'U4_export__{s}_v6'); _ex.parm('execute').pressButton()
    _errs = list(_ex.errors()) + [e for _i in _ex.inputs() for e in _i.errors()]
    if _errs: raise RuntimeError('export ' + s + ' cook error (1 October 2026: a wrangle error only shows AFTER the cook, the old map was silently reused): ' + _errs[0][:500])
    _age = _t.time() - __import__('os').path.getmtime(_ex.parm('copoutput').eval())
    if _age > 120: raise RuntimeError('export ' + s + ' did not write a new file (age %.0f s)' % _age)
hou.hipFile.save(B + 'CeramicGreen_Height_V5.hiplc')
# 30 September 2026 : the render after an export of the same file name reused the OLD textures (frame 047 was byte identical to 046 after a new height and normal). Delete the converted .rat caches and dirty the material so that
# the stage is re-cooked and the textures are re-read. FR : supprime les caches .rat et salit le materiau pour forcer la relecture des textures.
import glob, os
for f in glob.glob(B + 'render/*.rat'): os.remove(f)
sh_ = hou.node('/mat/CeramicGreen_Material'); sh_.parm('basecolor_useTexture').set(0); sh_.parm('basecolor_useTexture').set(1)
kp = st.node('cg_karma'); kp.parm('samplesperpixel').set(C.get('spp', 64)); kp.parm('varianceaa_maxsamples').set(C.get('spp', 64))
rop = st.node('cg_render'); rop.parm('outputimage').set(B + C['frame'])
rop.parm('override_res').set('specific'); rop.parm('res_user1').set(C.get('res', 2048)); rop.parm('res_user2').set(C.get('res', 2048))      # always set: a stale 1920 from an earlier frame made a frame 1920 and its noise statistics not comparable
hou.hscript('render -V 1 ' + rop.path())
result = 'cycle done'

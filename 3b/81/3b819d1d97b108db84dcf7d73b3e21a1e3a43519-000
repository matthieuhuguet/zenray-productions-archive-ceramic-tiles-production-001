 ('speckle', 'float sp2 = sm(0.80, 0.84, noise(set(@P.x * 700.0, @P.y * 700.0, 5.0)));\nS = withrgb(lerp(rgb(S), lin3(set(0.20, 0.45, 0.38)), sp2 * 0.5));'),
]

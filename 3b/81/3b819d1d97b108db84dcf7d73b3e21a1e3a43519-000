 ('joints', T('float jw = chf("<<c>>v2_joint_width"); float dark = 1.0 - sm(0.0, jw * 0.6, ed); float flank = (1.0 - sm(jw * 0.6, jw * 1.8, ed)) * (1.0 - dark);\nS = withrgb(lerp(rgb(S), lin3(set(0.04, 0.05, 0.04)), dark)); S = withrgb(lerp(rgb(S), lin3(set(0.30, 0.24, 0.14)), flank * 0.7));')),

CP = '/obj/CeramicGreen_Height/'
def T(code, **kw):
    kw.setdefault('c', CP)
    for k, v in kw.items(): code = code.replace('<<%s>>' % k, str(v))
    return code
f3 = lambda a: ', '.join('%.4f' % x for x in a)
SPECS = [
    {'name': 'v2_radius', 'label': 'Arc radius (tiles)', 'default': 0.5, 'range': (0.3, 0.7), 'help': 'Radius of the quarter arcs in tile units. 0.5 is measured on the reference: the arcs meet at the middle of the tile edges.'},
    {'name': 'v2_wall', 'label': 'Dish depth', 'default': 0.30, 'range': (0.0, 0.6)},
    {'name': 'v2_bowl', 'label': 'Dish wall width', 'default': 0.16, 'range': (0.02, 0.5), 'help': 'Distance from the arc over which the wall falls to the floor of the dish (tile units).'},
    {'name': 'v2_band_width', 'label': 'Tan band width', 'default': 0.042, 'range': (0.004, 0.08)},

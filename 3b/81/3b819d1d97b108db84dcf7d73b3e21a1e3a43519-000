LIB = '''
vector lin3(vector c) { return set(srgb2lin(c.x), srgb2lin(c.y), srgb2lin(c.z)); }
float arcd(vector2 p; vector2 c; vector2 sg; float R) {
    vector2 q = p - c;
    if (q.x * sg.x >= 0.0 && q.y * sg.y >= 0.0) return abs(length(q) - R);
    vector2 e1 = set(c.x + sg.x * R, c.y); vector2 e2 = set(c.x, c.y + sg.y * R);
    return min(length(p - e1), length(p - e2));
}
'''
ORI = sum(D['orientation'], []); CPA = sum(D['parity_xor'], [])
PRELUDE = T('''
int ORI[] = {<<ori>>}; int CPA[] = {<<cpa>>};
int NT = 5;
float gx = (@P.x * 0.5 + 0.5) * NT; float gy = (0.5 - @P.y * 0.5) * NT;
int tc = clamp(int(floor(gx)), 0, NT - 1); int tr = clamp(int(floor(gy)), 0, NT - 1);
float u = gx - float(tc); float v = gy - float(tr);                                    // 0 .. 1 in the tile, v measured down
int tid = tr * NT + tc; float R = chf("<<c>>v2_radius");
float dmin = 9.0;                                                                      // distance (tile units) to the nearest arc, arcs of the 3 x 3 neighbouring tiles included
for (int dr = -1; dr <= 1; dr++) { for (int dc = -1; dc <= 1; dc++) {
    int r2 = tr + dr; int c2 = tc + dc;
    if (r2 < 0 || r2 >= NT || c2 < 0 || c2 >= NT) continue;
    vector2 pp = set(u - float(dc), v - float(dr));
    if (ORI[r2 * NT + c2] == 0) { dmin = min(dmin, arcd(pp, set(0.0, 0.0), set(1.0, 1.0), R)); dmin = min(dmin, arcd(pp, set(1.0, 1.0), set(-1.0, -1.0), R)); }
    else { dmin = min(dmin, arcd(pp, set(1.0, 0.0), set(-1.0, 1.0), R)); dmin = min(dmin, arcd(pp, set(0.0, 1.0), set(1.0, -1.0), R)); }
} }
int ins = 0;
if (ORI[tid] == 0) { if (length(set(u, v)) < R || length(set(u - 1.0, v - 1.0)) < R) ins = 1; } else { if (length(set(u - 1.0, v)) < R || length(set(u, v - 1.0)) < R) ins = 1; }
int par = ins ^ CPA[tid];                                                              // 1 = dish, 0 = plateau
float ed = 0.5 - max(abs(u - 0.5), abs(v - 0.5));                                      // distance to the tile edge
''', ori=', '.join(str(x) for x in ORI), cpa=', '.join(str(x) for x in CPA))

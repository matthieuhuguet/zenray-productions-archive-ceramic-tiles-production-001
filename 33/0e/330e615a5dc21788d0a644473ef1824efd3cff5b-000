# 1 October 2026 : runs INSIDE Houdini. Exports the six maps with the raised ridge nodes bypassed (= the V058 look) to render/scratch/check_<map>.png and reports the cold cook time of the whole graph.
# Compare offline with Scripts/CompareMaps.py. FR : export des six cartes (etat V058) pour le controle de non regression des cartes.
import hou, time
net = hou.node('/obj/CeramicGreen_Height')
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles/render/'
RN = ('N9_normal__ridge_bevel_on_both_edges', 'ZK_rough__terracotta_roughness_mask_on_band_and_joints', 'RK_reflect__terracotta_coat_weight_on_band_and_joints', 'ZL_albedo__contact_shadow_beside_the_ridge')
was = [net.node(n).isBypassed() for n in RN]
for n in RN: net.node(n).bypass(True)
res = {'nodes': len(net.children())}; r0 = net.parm('ring_radius').eval(); net.parm('ring_radius').set(r0 + 1e-6); tot = 0
for s in ('height', 'normal', 'basecolor', 'roughness', 'reflect', 'ao'):
    ex = net.node(f'U4_export__{s}_v6'); orig = ex.parm('copoutput').eval(); ex.parm('copoutput').set(B + f'scratch/check_{s}.png')
    t = time.time(); ex.parm('execute').pressButton(); dt = time.time() - t; ex.parm('copoutput').set(orig); tot += dt
    if ex.errors(): res['ERROR_' + s] = list(ex.errors())[:1]
net.parm('ring_radius').set(r0)
for n, b in zip(RN, was): net.node(n).bypass(b)
res['cold_total_s'] = round(tot, 2)
result = res

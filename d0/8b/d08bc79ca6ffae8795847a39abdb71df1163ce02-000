def _phase_name(prefix, mp, i, nm): return '%s%s_%02d_%s' % (prefix, mp, i, nm)
def build(variant, fuse):
    """variant: dict(prefix, lib, prelude, stages{map:[(name, code)]}, normal_scale, base_input_name). Returns {map: final node}. Idempotent: nodes of the OTHER phase are deleted."""
    n = L.net(); p = variant['prefix']; base = n.node(variant['base_input']); out = {}
    y0 = variant['ypos']; col = variant['colour']
    for row, mp in enumerate(('height', 'basecolor', 'roughness', 'reflect', 'ao')):
        stages = variant['stages'][mp]; mono = mp in ('height', 'roughness', 'ao')
        for ch in list(n.children()):
            if ch.name().startswith('%s%s_' % (p, mp)): ch.destroy()
        names = []
        if fuse:
            body = 'vector4 S = set(0.0, 0.0, 0.0, 1.0);\n' + ''.join('{\n' + variant['prelude'] + code + '\n}\n' for (_, code) in stages)
            tail = 'f@C = S.x;' if mono else 'p@C = S;'
            w = L.wrangle('%s%s_fused' % (p, mp), LIB + variant['lib'] + body + tail, [base], (0.0, y0 - row * 2.2), col)
            w.parm('type1').set(0 if mono else 3); out[mp] = w
        else:
            prev = base
            for i, (nm, code) in enumerate(stages):
                last = i == len(stages) - 1
                head = ('vector4 S = set(0.0, 0.0, 0.0, 1.0);\n' if i == 0 else 'vector4 S = p@C;\n')
                tail = 'p@C = S;'                       # layered: the state stays RGBA from node to node (a wrangle cannot read RGBA and write mono under the same layer name)
                w = L.wrangle(_phase_name(p, mp, i + 1, nm), LIB + variant['lib'] + head + variant['prelude'] + code + '\n' + tail, [prev if i else base], (2.6 * (i + 1), y0 - row * 2.2), col)
                w.parm('type1').set(3); prev = w
            if mono:
                prev = L.node('channelextract', _phase_name(p, mp, len(stages) + 1, 'mono'), [prev], (2.6 * (len(stages) + 1), y0 - row * 2.2), col)
            out[mp] = prev
    return out
def clean(variant, fuse_names=True):
    n = L.net()
    for ch in list(n.children()):
        if ch.name().startswith(variant['prefix']) and ch.type().name() in ('wrangle', 'heighttonormal', 'null'): ch.destroy()
def normals(variant, height_node, scale):
    n = L.net(); p = variant['prefix']
    hn = L.node('heighttonormal', p + 'NORMAL_01_from_height', [height_node], (2.6, variant['ypos'] - 6 * 2.2), variant['colour'], normaltype=1, scale=scale, readoutside=1, kernel=1)
    fl = L.wrangle(p + 'NORMAL_02_flip_green_directx', 'v@C = set(@C.x, 1.0 - @C.y, @C.z);', [hn], (5.2, variant['ypos'] - 6 * 2.2), variant['colour'])
    return fl
def wire_switch(variant_index, nodes):
    """connect the finished branch to inputs of the six SW_n nodes (input index = variant index)."""
    n = L.net()
    for i, m in enumerate(L.MAPS):
        sw = n.node('SW_%d_%s' % (i + 1, m.upper())); sw.setInput(variant_index, nodes[m])

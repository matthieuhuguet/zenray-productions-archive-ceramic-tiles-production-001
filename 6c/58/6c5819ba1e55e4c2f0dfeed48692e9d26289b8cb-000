# 1 October 2026 : measures the glaze colours of the two colour references. ONLY the colours are used, never the pattern (01b is a 6 x 6 leaf pattern, 02a an S-curve pattern, neither is the ceramic tiles pattern).
#  01b : median glaze colour of each of the 36 tiles (the tan band, the highlights and the joints are excluded); 02a : median glaze colour of the whole picture with the same exclusions; 01a (the current green) as the control.
# Output: ref-maps/palettes.json. FR : mesure des couleurs de verre de 01b (par carreau) et 02a, jamais du motif.
import json, numpy as np
from PIL import Image
from scipy import ndimage as ndi
B = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles/'
def load(n, size=None):
    im = Image.open(B + n).convert('RGB')
    if size: im = im.resize((size, size), Image.LANCZOS)
    return np.asarray(im, float) / 255
L = lambda x: (x * [0.2126, 0.7152, 0.0722]).sum(-1)
def glaze_mask(a, sat_min=0.0):
    mx, mn = a.max(-1), a.min(-1); lum = L(a); sat = (mx - mn) / (mx + 1e-6)
    tan = (a[..., 0] > 1.12 * a[..., 1]) & (a[..., 0] > 1.25 * a[..., 2]) & (lum > 0.12)      # clay band and orange glazes: handled apart
    hi = (lum > 0.62) | ((lum > 0.40) & (sat < 0.10))                                          # specular highlights
    dark = lum < 0.04
    return ~hi & ~dark, tan
out = {}
# --- 01a control
a = load('01a-julien-delannoy-10-left.png', 1920); g, tan = glaze_mask(a); m = g & ~tan
out['01a'] = {'median': np.median(a[m], 0).round(4).tolist(), 'lum': float(np.median(L(a[m])))}
# --- 02a
b = load('02a-julien-delannoy-11-left.png'); g, tan = glaze_mask(b)
H = b.shape[0]; yy, xx = np.mgrid[0:H, 0:H]
# 02a tile grid is 5 x 5; exclude the clay arcs by the tan test (dilated) and the joints (thin dark lines)
bandz = ndi.binary_dilation(tan, iterations=6)
m = g & ~bandz
out['02a'] = {'median': np.median(b[m], 0).round(4).tolist(), 'p25': np.percentile(b[m], 25, 0).round(4).tolist(), 'p75': np.percentile(b[m], 75, 0).round(4).tolist(), 'lum': float(np.median(L(b[m]))), 'size': H}
# --- 01b: 6 x 6 tiles
c = load('01b-julien-delannoy-10-right.png'); H = c.shape[0]; N = 6; ts = H // N
g, tan = glaze_mask(c)
tiles = []
for r in range(N):
    row = []
    for q in range(N):
        sl = (slice(r * ts + int(ts * 0.18), (r + 1) * ts - int(ts * 0.18)), slice(q * ts + int(ts * 0.18), (q + 1) * ts - int(ts * 0.18)))
        px = c[sl]; mm = g[sl]
        # orange and ochre tiles are glazes too: keep tan-ish pixels when the tile is mostly tan
        if tan[sl].mean() < 0.5: mm = mm & ~tan[sl]
        v = np.median(px[mm], 0) if mm.sum() > 500 else np.median(px.reshape(-1, 3), 0)
        row.append({'rgb': v.round(4).tolist(), 'lum': float(L(v)), 'tan_fraction': float(tan[sl].mean())})
    tiles.append(row)
out['01b'] = {'tiles': tiles, 'size': H, 'grid': N}
json.dump(out, open(B + 'ref-maps/palettes.json', 'w'), indent=1)
print('01a control median', out['01a']['median'], 'lum', round(out['01a']['lum'], 3))
print('02a median', out['02a']['median'], 'lum', round(out['02a']['lum'], 3), 'p25', out['02a']['p25'], 'p75', out['02a']['p75'])
print('01b tile median colours (R G B) and luminance:')
for r in range(N): print('  ', '  '.join('%.2f,%.2f,%.2f' % tuple(t['rgb']) for t in tiles[r]))
print('01b luminance grid:')
for r in range(N): print('  ', '  '.join('%.3f' % t['lum'] for t in tiles[r]))

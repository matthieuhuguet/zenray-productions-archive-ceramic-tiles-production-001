float sqn = chf("<<c>>v3_exp");
float rr = pow(pow(abs(u - cx) / hx, sqn) + pow(abs(v - cy) / hy, sqn), 1.0 / sqn);   // 1 on the bowl rim
float rd = (rr - 1.0) * min(hx, hy);                                                  // signed distance to the rim in tile units, negative inside the bowl
float tl = ta * u + tb * v;                                                           // tilt coordinate: positive towards the steep side
float ed = 0.5 - max(abs(u), abs(v));                                                 // distance to the tile edge
float opn = sm(-0.1, 0.5, tl * 1.5);                                                  // 0 = sharp rim side, 1 = open side where the wall melts into the frame (the swoosh of the reference)
''')

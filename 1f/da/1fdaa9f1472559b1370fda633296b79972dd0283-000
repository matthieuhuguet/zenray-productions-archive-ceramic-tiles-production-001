PRELUDE = T('''
int NT = 6;
float gx = (@P.x * 0.5 + 0.5) * float(NT); float gy = (0.5 - @P.y * 0.5) * float(NT);
int tc = clamp(int(floor(gx)), 0, NT - 1); int tr = clamp(int(floor(gy)), 0, NT - 1);
float u = gx - float(tc) - 0.5; float v = gy - float(tr) - 0.5;                       // tile centred coordinates, -0.5 .. 0.5, v measured down
int tid = tr * NT + tc;
float jit = chf("<<c>>v3_jitter");
float ta = hsh(tid, 1.0) * 1.2 - 0.4; float tb = hsh(tid, 2.0) * 1.2 - 0.4;            // tilt direction, biased towards the right and the bottom like the reference
float cx = jit * 0.03 * (hsh(tid, 4.0) * 2.0 - 1.0) - 0.04 * ta; float cy = jit * 0.03 * (hsh(tid, 5.0) * 2.0 - 1.0) - 0.04 * tb;

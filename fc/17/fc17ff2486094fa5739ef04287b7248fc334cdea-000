    ct = vex(net, 'M6_color__cloudy_glaze_variation', [edge], CLOUD_VEX % {'freq': P['cloud_freq'], 'freq2': P['cloud_freq'] * 2.3, 'tiles': P['tiles'], 'grain_freq': P['grain_freq'], 'speck_freq': P['speck_freq'], 'speck_cut': P['speck_cut'], 'tile_amp': P['tile_tint_amp'], 'ax': P['cloud_amp'][0], 'ay': P['cloud_amp'][1], 'az': P['cloud_amp'][2]})

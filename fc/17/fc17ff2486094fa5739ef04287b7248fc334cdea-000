float v = frac((0.5 - @P.y * 0.5) * %(tiles)d);
'''

ARC_VEX = UV_VEX + '''float d = abs(length(set(u - %(cu)d, v - %(cv)d)) - %(radius)s);
p@C = set(d, d, d, 1.0);
'''

EDGE_VEX = UV_VEX + '''float d = min(min(u, 1.0 - u), min(v, 1.0 - v));   // distance to the nearest tile edge
p@C = set(d, d, d, 1.0);
'''

CENTRE_VEX = UV_VEX + '''float d = length(set(u - 0.5, v - 0.5));          // distance from the tile centre
p@C = set(d, d, d, 1.0);
'''

CLOUD_VEX = '''// 30 September 2026 : glaze variation as a colour delta (alpha 0 so that Add really adds): large soft clouds, one random tint per tile, fine mottling and
// sparse light speckles, as seen on the final render. FR : variation de glacure : nuages, une teinte par carreau, grain fin, points clairs epars.

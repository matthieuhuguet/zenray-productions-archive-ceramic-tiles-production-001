CURVE_FN = '''// 30 September 2026 : cubic Hermite through the knots, tangents by finite differences; flat outside the first and last knot.
float curve_eval(float x; float K[]; float V[]) {
    int n = len(K);
    if (x <= K[0]) return V[0];
    if (x >= K[n - 1]) return V[n - 1];
    int i = 0;
    while (i < n - 2 && x > K[i + 1]) i++;
    float h = K[i + 1] - K[i];
    float t = (x - K[i]) / h;
    float m0 = (i > 0) ? (V[i + 1] - V[i - 1]) / (K[i + 1] - K[i - 1]) : (V[i + 1] - V[i]) / h;
    float m1 = (i < n - 2) ? (V[i + 2] - V[i]) / (K[i + 2] - K[i]) : (V[i + 1] - V[i]) / h;
    float t2 = t * t, t3 = t2 * t;
    return (2 * t3 - 3 * t2 + 1) * V[i] + (t3 - 2 * t2 + t) * h * m0 + (-2 * t3 + 3 * t2) * V[i + 1] + (t3 - t2) * h * m1;
}
'''


def arr(name, values):
    return 'float %s[] = {%s};' % (name, ', '.join('%.6f' % v for v in values))


def node(net, kind, name, inputs=(), **parms):
    n = net.node(name) or net.createNode(kind, name)
    for i, src in enumerate(inputs):
        if src is not None:
            n.setInput(i, src[0] if isinstance(src, tuple) else src, src[1] if isinstance(src, tuple) else 0)
    for k, v in parms.items():
        n.parm(k).set(v)
    return n


def vex(net, name, inputs, code):
    n = node(net, 'wrangle', name, inputs)
    n.parm('vexsnippet').set(code)
    return n


def curve_node(net, name, src, keys, wexpr='1.0', hexpr=None):
    # a mono field in, the same field passed through the curve out (VEX, full float precision)
    ks = [k for k, _ in keys]; vs = [v for _, v in keys]
    return vex(net, name, [src], CURVE_FN + arr('K', ks) + '\n' + arr('V', vs) + '\nfloat x = p@C.x / max(%s, 0.0001);   // 30 September 2026 : layers are RGBA vector4 here, read red and write grey; wexpr = HDA width factor\nfloat y = curve_eval(x, K, V);\n%sp@C = set(y, y, y, 1.0);\n' % (wexpr, ('y = K_FLOOR + (y - K_FLOOR) * %s;   // HDA height factor\n' % hexpr).replace('K_FLOOR', '%.5f' % vs[-1]) if hexpr else ''))


TABLE_VEX = '''// 30 September 2026 : per corner, 1 = full arc and 0 = the fainter fourth arc. Measured on the real height: even rows keep TL faint,
// odd rows keep BR faint; the checkerboard runs on (row + col). FR : 1 = arc plein, 0 = quatrieme arc faible.
int n = %(tiles)d;
int col = clamp(int((@P.x * 0.5 + 0.5) * n), 0, n - 1);
int row = clamp(int((0.5 - @P.y * 0.5) * n), 0, n - 1);      // P.y = +1 is the TOP of the canvas, row 0 is the top row
int tlweak = ((row + col) %% 2 == %(parity)d) ? 1 : 0;
p@C = set(tlweak ? 0.0 : 1.0, 1.0, 1.0, tlweak ? 1.0 : 0.0);
'''

UV_VEX = '''// 30 September 2026 : tile-local coordinates in tile units (0..1, v measured DOWN from the top edge), computed from the canvas position @P,
// because the Tile Pattern uv layer is not readable as an attribute in a wrangle. FR : coordonnees locales au carreau, calculees depuis @P.

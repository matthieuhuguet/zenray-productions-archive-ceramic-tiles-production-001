int tc = int((@P.x * 0.5 + 0.5) * %(tiles)d);
int tr = int((0.5 - @P.y * 0.5) * %(tiles)d);
float tile_r = rand(tc * 7.13 + tr * 3.71 + 0.5) - 0.5;
float mott = noise(set(@P.x * %(grain_freq).1f, @P.y * %(grain_freq).1f, 1.3)) - 0.5;
float sp = noise(set(@P.x * %(speck_freq).1f, @P.y * %(speck_freq).1f, 5.9));
float speck = smooth(%(speck_cut).3f, %(speck_cut).3f + 0.03, sp);
float k = n + tile_r * %(tile_amp).3f + mott * 0.25;
p@C = set(k * %(ax).4f + speck * 0.10, k * %(ay).4f + speck * 0.11, k * %(az).4f + speck * 0.08, 0.0);
'''


def build():
    net = hou.node(NET)
    make_controls(net)                                   # spare parameters survive the rebuild, tweaked values are kept
    for c in net.children():
        c.destroy()
    net.parm('setres').set(1); net.parm('res1').set(P['res']); net.parm('res2').set(P['res'])
    S = {}
    def reg(sec, *nodes):
        S.setdefault(sec, []).extend(n.name() for n in nodes)

    # A  LAYOUT ------------------------------------------------------------------------------------------------------
    lay = node(net, 'tilepattern', 'A1_layout__tile_grid_4x4', patterntype=0, patternmode=1, stackbond_rows=P['tiles'], stackbond_cols=P['tiles'])
    lay.parm('stackbond_tilewidth').set(2.0 / P['tiles']); lay.parm('stackbond_tileheight').set(2.0 / P['tiles'])
    reg('A  LAYOUT  the tile grid', lay)
    uv = (lay, 2)

    # B  THE LAYOUT: DISTANCE TO THE A CIRCLE AND TO THE B CIRCLE OF EACH QUADRANT ------------------------------------------------------
    # 30 September 2026: the motif is data (CeramicGreenLayout.py): per tile and per quadrant, a quarter circle centred on the corner (A), on the tile centre (B), both (lens) or none.
    pre = (UV_VEX % {'tiles': P['tiles']}) + 'int tc = clamp(int((@P.x * 0.5 + 0.5) * %d.0), 0, %d);\nint tr = clamp(int((0.5 - @P.y * 0.5) * %d.0), 0, %d);\n' % (P['tiles'], P['tiles'] - 1, P['tiles'], P['tiles'] - 1)
    lay_n = vex(net, 'B1_layout__signed_distance_to_the_A_and_B_circles', [uv], LAYOUT_VEX + pre + 'float dA; float dB; float dsh;\nlay(LT01A, LC01A, tc, tr, u, v, %s, int(%s + 0.5), dA, dB, dsh);\np@C = set(dA, dB, dsh, 1.0);   // red = corner circle, green = tile centre circle, blue = dish parity (1 = hollow dish)\n' % (CH('ring_radius'), CH('layout_source')))
    dAn = vex(net, 'B2_layout__distance_to_the_corner_circle', [lay_n], 'float d = abs(p@C.x);\np@C = set(d, d, d, 1.0);\n')
    dBn = vex(net, 'B3_layout__distance_to_the_tile_centre_circle', [lay_n], 'float d = abs(p@C.y);\np@C = set(d, d, d, 1.0);\n')
    reg('B  LAYOUT  which arcs are drawn, and the distance to them', lay_n, dAn, dBn)

    # C  THE GLOW OF EACH FAMILY: corner circles (A) and tile centre circles (B, thinner) -------------------------------------------------------
    gA = curve_node(net, 'C1_glow__of_the_corner_circles', dAn, P['strong_keys'], CH('arc_width'), CH('wall_height'))
    gB = curve_node(net, 'C2_glow__of_the_tile_centre_circles', dBn, P['centre_keys'], CH('arc_width') + ' * ' + CH('small_circle_width'), CH('wall_height'))
    wA = vex(net, 'C3_glow__soft_weight_of_A', [gA], 'float g = p@C.x;\nfloat w = exp(%.4f * g);\np@C = set(w, w, w, 1.0);   // part of the smooth maximum\n' % P['softmax_k'])
    wB = vex(net, 'C4_glow__soft_weight_of_B', [gB], 'float g = p@C.x;\nfloat w = exp(%.4f * g);\np@C = set(w, w, w, 1.0);\n' % P['softmax_k'])
    reg('C  GLOW  one curve per family', gA, gB, wA, wB)

    # D  THE HIGHEST GLOW WINS (smooth maximum) --------------------------------------------------------------------------------------------
    s3 = node(net, 'blend', 'D1_glow__weights_of_A_and_B', [wA, wB], mode=3)
    glow = vex(net, 'D4_glow__smooth_highest_of_the_four_corners', [s3], 'float w = p@C.x;\nfloat g = log(max(w, 1e-9)) / %.4f;\np@C = set(g, g, g, 1.0);\n' % P['softmax_k'])
    reg('D  GLOW  smooth highest wins', s3, glow)

    # E  BASE: SMOOTH RADIAL GRADIENT + JOINT GROOVE ------------------------------------------------------------------------
    centre = vex(net, 'E1_base__distance_from_tile_centre', [uv], CENTRE_VEX % {'tiles': P['tiles']})
    rbase = curve_node(net, 'E2_base__smooth_radial_profile', centre, P['radial_keys'])
    edge = vex(net, 'E3_joints__distance_to_tile_edge', [uv], EDGE_VEX % {'tiles': P['tiles']})
    groove = curve_node(net, 'E4_joints__groove_profile', edge, P['joint_keys'], CH('joint_width'))
    with_base = node(net, 'blend', 'E5_relief__glow_plus_radial_base', [glow, rbase], mode=3)
    height0 = node(net, 'blend', 'E6_relief__plus_joint_groove', [with_base, groove], mode=3)
    # 30 September 2026 (feedback: every ceramic is dished INWARDS, each connected region dug uniformly): the regions of the dish colour of the two colour layout are lowered by the HDA parameter dish_depth.
    # FR : l'interieur de chaque cercle dessine est abaisse sous le plateau plat (cuvettes creusees vers l'interieur).
    # 30 September 2026 : the bowl profile is computed alone, blurred to round the crease of the nearest-arc distance (medial axis), then multiplied by the dish parity so that the walls stay sharp.
    # FR : le profil de bol est calcule seul, floute pour arrondir le pli de l'axe median, puis multiplie par la parite de cuvette : les murs restent nets.
    bowl0 = vex(net, 'E8a_relief__bowl_profile_from_the_distance_to_the_arcs', [lay_n], 'float dd = min(abs(p@C.x), abs(p@C.y));      // distance to the nearest arc, tile units\nfloat bowl = smooth(0.0, %f, dd);             // 0 at the wall, 1 far from it\np@C = set(bowl, bowl, bowl, 1.0);\n' % P['bowl_width'])
    bowl1 = node(net, 'blur', 'E8b_relief__bowl_rounded_at_the_crease', [bowl0], units=1, size_pixel=P['bowl_round_px'], filter=1)
    floor1 = vex(net, 'E8c_relief__bowl_floor_shape', [bowl1], 'float f = %f + (1.0 - %f) * p@C.x;     // flat step share + bowl share\np@C = set(f, f, f, 1.0);\n' % (P['bowl_flat'], P['bowl_flat']))
    kmap = vex(net, 'E8d_relief__dish_parity', [lay_n], 'float k = p@C.z;   // 1 = hollow dish\np@C = set(k, k, k, 1.0);\n')
    prod = node(net, 'blend', 'E8e_relief__parity_times_floor_shape', [kmap, floor1], mode=5)
    dish = vex(net, 'E8_relief__dish_floor_lowered_inside_the_circles', [prod], 'float d = -%s * p@C.x;\np@C = set(d, d, d, 1.0);   // 30 September 2026 : the dish is a BOWL (concave) not a flat step, so that the coat reflects the light along crescents as in 01a\n' % CH('dish_depth'))
    height = node(net, 'blend', 'E9_relief__plus_dish_floor', [height0, dish], mode=3)
    mono = node(net, 'channelextract', 'E7_relief__as_one_grey_channel', [height], channel=0)
    reg('E  BASE  smooth radial base, joint groove, dish floor', centre, rbase, edge, groove, with_base, height0, bowl0, bowl1, floor1, kmap, prod, dish, height, mono)

    # I  OUTPUT ---------------------------------------------------------------------------------------------------------------
    out = node(net, 'null', 'I1_HEIGHT__ceramic_green_v5', [mono])
    rop = node(net, 'rop_image', 'I3_export__height_png', [out])
    rop.parm('copoutput').set(OUT_DIR + '/render/CeramicGreen_V5_height.png'); rop.parm('colorconversion').set('raw')
    out.setDisplayFlag(True)
    reg('I  OUTPUT  height', out, rop)

    # J  NORMAL, straight from the height --------------------------------------------------------------------------------------
    # 30 September 2026, measured against the real normal strip: scale 0.06 gives the same slope spread, the 0..1 (offset) type is what the
    # reference uses, and its green channel is INVERTED (DirectX). FR : echelle 0.06, type offset 0..1, vert inverse (convention DirectX).
    nrm = node(net, 'heighttonormal', 'J1_normal__from_height', [out], normaltype=1, scale=P['normal_scale'])
    flip = vex(net, 'J2_normal__flip_green_for_directx', [nrm], 'v@C = set(@C.x, 1.0 - @C.y, @C.z);   // 30 September 2026 : invert green\n')
    nrop = node(net, 'rop_image', 'J3_export__normal_png', [flip])
    nrop.parm('copoutput').set(OUT_DIR + '/render/CeramicGreen_V5_normal.png'); nrop.parm('colorconversion').set('raw')
    reg('J  NORMAL  from the height, green inverted', nrm, flip, nrop)

    # K  AMBIENT OCCLUSION ---------------------------------------------------------------------------------------------------------
    # 30 September 2026, measured on ref_ao: flat 0.90 everywhere, the raised arcs are a thin bright ring (up to 1.0, ring width about 0.02 tile = where
    # the strong glow is above 0.6), and the joints go dark (0.76 on average over the first 0.004 tile, about 0.4 at the very edge).
    # FR : AO mesuree sur ref_ao : plat a 0.90, anneau clair sur l'arc (jusqu'a 1.0), joints sombres.
    ao_ring = curve_node(net, 'K1_ao__ring_brightening_from_glow', glow, P['ao_ring_keys'])
    ao_joint = curve_node(net, 'K2_ao__joint_darkening_from_edge', edge, P['ao_joint_keys'])
    ao = node(net, 'blend', 'K3_ao__ring_times_joint', [ao_ring, ao_joint], mode=5)
    ao_out = node(net, 'null', 'K4_AO__ceramic_green_v5', [node(net, 'channelextract', 'K5_ao__as_one_grey_channel', [ao], channel=0)])
    aorop = node(net, 'rop_image', 'K6_export__ao_png', [ao_out])
    aorop.parm('copoutput').set(OUT_DIR + '/render/CeramicGreen_V5_ao.png'); aorop.parm('colorconversion').set('raw')
    reg('K  AO  ring brightening times joint darkening', ao_ring, ao_joint, ao, ao_out.inputs()[0], ao_out, aorop)

    # L  ROUGHNESS ---------------------------------------------------------------------------------------------------------------------
    # 30 September 2026, measured on ref_roughness: glossy glaze at 0.047 everywhere, rising to 0.20 at the very edge of the joint (0.13 then 0.086 then 0.054).
    # FR : rugosite mesuree : glacure brillante 0.047 partout, montee a 0.20 au bord du joint.
    rough = curve_node(net, 'L1_roughness__glaze_and_joint_from_edge', edge, P['rough_keys'])
    rough_out = node(net, 'null', 'L2_ROUGHNESS__ceramic_green_v5', [node(net, 'channelextract', 'L3_roughness__as_one_grey_channel', [rough], channel=0)])
    rrop = node(net, 'rop_image', 'L4_export__roughness_png', [rough_out])
    rrop.parm('copoutput').set(OUT_DIR + '/render/CeramicGreen_V5_roughness.png'); rrop.parm('colorconversion').set('raw')
    reg('L  ROUGHNESS  glaze and joint', rough, rough_out.inputs()[0], rough_out, rrop)

    # M  BASECOLOR ---------------------------------------------------------------------------------------------------------------------
    # 30 September 2026, measured on ref_basecolor: green glaze (0.417, 0.462, 0.317), a little lighter near the joints (0.515, 0.50, 0.36), and a slight
    # lightening where the glow is low (flat centre of the tile). Each layer below is a grey weight multiplied by a colour offset, then added.
    # FR : couleur de base mesuree : vert (0.417, 0.462, 0.317), plus clair aux joints, leger eclaircissement au centre plat.
    base = vex(net, 'M1_color__green_glaze_constant', [edge], 'p@C = set(%.4f, %.4f, %.4f, 1.0);   // 30 September 2026 : input ignored on purpose\n' % tuple(P['glaze_rgb']))
    jw = curve_node(net, 'M2_color__joint_weight_from_edge', edge, P['joint_weight_keys'])
    rw = curve_node(net, 'M3_color__arc_ring_weight_from_glow', glow, P['ring_weight_keys'])
    gw_ = node(net, 'blend', 'M4_color__grout_weight_joint_or_ring', [jw, rw], mode=12)

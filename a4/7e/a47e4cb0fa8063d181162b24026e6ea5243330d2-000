# 30 September 2026 : Houdini smooth(a, b, x) misbehaves when a > b (it gave a constant darkening over the whole map); sm() handles both directions.
# FR : smooth() de Houdini se comporte mal si a > b ; sm() gere les deux sens.
SM = 'float sm(float a; float b; float x) { return a <= b ? smooth(a, b, x) : 1.0 - smooth(b, a, x); }\n'
UV = SM + ('float u = frac((@P.x * 0.5 + 0.5) * %d.0);\nfloat v = frac((0.5 - @P.y * 0.5) * %d.0);\n'
      'int tc = clamp(int((@P.x * 0.5 + 0.5) * %d.0), 0, %d);\nint tr = clamp(int((0.5 - @P.y * 0.5) * %d.0), 0, %d);\n') % (N, N, N, N - 1, N, N - 1)
EDGE, GLOW = 'E3_joints__distance_to_tile_edge', 'D4_glow__smooth_highest_of_the_four_corners'
sections = {}

def layer(sec, name, code, src=EDGE):
    n = vex(net, name, [net.node(src)], UV + code)
    sections.setdefault(sec, []).append(n.name()); return n
def acc(sec, prev, name, lay):
    n = node(net, 'blend', name, [prev, lay], mode=3)
    sections.setdefault(sec, []).append(n.name()); return n
def grey(expr):  return 'float d = 0.0;\n%s\np@C = set(d, d, d, 0.0);\n' % expr
def rgb(expr):   return 'vector dc = {0, 0, 0};\n%s\np@C = set(dc.x, dc.y, dc.z, 0.0);\n' % expr
def tile_if(c, r, body): return 'if (tc == %d && tr == %d) { %s }' % (c, r, body)
def rnd(c, r, k): return 'rand(%d.0 * 7.13 + %d.0 * 3.71 + %d.5)' % (c, r, k)
def noise3(f, z, x='@P.x', y='@P.y'): return 'noise(set(%s * %s, %s * %s, %s))' % (x, f, y, f, z)

